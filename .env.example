# Where Tendril is reachable. Used to build links on the Today page and setup page.
PUBLIC_BASE_URL=http://localhost:8000

# Storage: SQLite database, rendered plan images and voice notes live here.
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/tendril.db

# Ollama (local open-weight text model)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90

# faster-whisper (voice notes). Language: en, hi or auto. The model downloads on first use.
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT=180

# Open-Meteo (free, no key)
WEATHER_TIMEOUT=10

# Morning job in the garden's timezone: Sunday = new week plan, other days = weather refresh.
SCHEDULER_ENABLED=true
MORNING_HOUR=7

# Protects /setup (which shows the private Today link). Set this before exposing Tendril online.
SETUP_PASSWORD=

LOG_LEVEL=INFO
