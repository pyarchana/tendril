# Where Tendril is reachable. Used for the phone link and QR code on the setup page.
# Local: http://localhost:8000   Server: https://garden.example.com
PUBLIC_BASE_URL=http://localhost:8000

# Your domain, for Caddy's automatic HTTPS (only used with: docker compose --profile https up -d)
DOMAIN=garden.example.com

# Protects /setup (which shows the private Today link). Set this before exposing Tendril online.
SETUP_PASSWORD=

# Storage: SQLite database, plan images, voice notes and the whisper model live here.
# Docker Compose overrides these to use the tendril-data volume.
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/tendril.db

# Ollama (local open-weight text model). Compose points OLLAMA_URL at the ollama service.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=300

# faster-whisper (voice notes). Language: en, hi or auto.
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT=180
# Download and load the model at startup so the first voice note is quick (Compose sets this to true).
WHISPER_PRELOAD=false

# Open-Meteo (free, no key)
WEATHER_TIMEOUT=10

# Morning job in the garden's timezone: Sunday = new week plan, other days = weather refresh.
SCHEDULER_ENABLED=true
MORNING_HOUR=7

# Which address Docker publishes the app on. Keep 127.0.0.1 behind Caddy; use 0.0.0.0 to try it from a phone on your Wi-Fi.
APP_BIND=127.0.0.1

LOG_LEVEL=INFO
